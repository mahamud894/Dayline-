<?xml version="1.0" encoding="utf-8"?>
<!-- Dayline mark: a sun rising over the day's horizon line. Kept inside the 66dp safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft glow behind the sun -->
    <path android:pathData="M26,62 A28,28 0 0,1 82,62 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="62"
                android:gradientRadius="28"
                android:startColor="#55B7FF4A"
                android:endColor="#00B7FF4A" />
        </aapt:attr>
    </path>

    <!-- Rays -->
    <path
        android:pathData="M54,30 L54,35 M38.4,36.4 L41.6,39.6 M69.6,36.4 L66.4,39.6 M31.5,49 L35.8,50.6 M76.5,49 L72.2,50.6"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeColor="#FFB7FF4A" />

    <!-- Rising sun -->
    <path android:pathData="M37,62 A17,17 0 0,1 71,62 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="45"
                android:endX="54"
                android:endY="62"
                android:startColor="#FFD4FF6E"
                android:endColor="#FF59F5D8" />
        </aapt:attr>
    </path>

    <!-- Horizon: the day line -->
    <path
        android:pathData="M29,66.5 L79,66.5"
        android:strokeWidth="4.5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="29"
                android:startY="66.5"
                android:endX="79"
                android:endY="66.5"
                android:startColor="#FFBD82FF"
                android:endColor="#FFFF7EB6" />
        </aapt:attr>
    </path>

    <!-- Reflection line -->
    <path
        android:pathData="M41,75 L67,75"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeColor="#80BD82FF" />
</vector>
